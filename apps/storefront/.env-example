# Setup the environment for local development
# You do not need to set these for production builds

# API URL for local development
VITE_B2B_URL=https://api-b2b.service.bcdev

# App Client ID issued by B2B Edition for the storefront
# cspell:disable-next-line
VITE_LOCAL_APP_CLIENT_ID=qxvapwlk4fbb9dyogdcxk9o50d9jqjo

# Set this to TRUE to enable local environment specific logic
# Make sure to set this to FALSE when building for production deployment in your CI/CD setup
VITE_IS_LOCAL_ENVIRONMENT=TRUE

# For custom host, set this to the absolute path where will be hosted the generated assets after your run `yarn build`
VITE_ASSETS_ABSOLUTE_PATH=''
# --- PO Agent instance config ---------------------------------------------
# The store this instance points at. No store is hardcoded in the repo, so both
# dev proxies (/bigcommerce and /bc-graphql) and the PurchaseOrderAgent page
# resolve their target from this value. The bc-graphql Netlify function reads it
# too, so set it in the Netlify site's environment as well as here.
# Find it in your store's control panel URL: store-<hash>.mybigcommerce.com
VITE_STORE_HASH=

# Optional. Overrides the /bigcommerce dev proxy target when the shopping
# storefront lives on a custom domain rather than store-<hash>.mybigcommerce.com.
# Leave blank to derive it from VITE_STORE_HASH.
VITE_PROXY_SHOPPING_URL=
